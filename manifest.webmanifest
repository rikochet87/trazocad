{
  "name": "TrazoCAD — Dibujo 2D de precisión",
  "short_name": "TrazoCAD",
  "description": "Software de dibujo técnico 2D inspirado en AutoCAD: línea de comandos, referencias a objetos, capas, cotas y DXF. Funciona sin conexión.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#161a20",
  "theme_color": "#1b2027",
  "categories": ["productivity", "graphics", "design"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-trazocad": [".tcad"],
        "application/dxf": [".dxf"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Nuevo dibujo", "url": "./?nuevo", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
